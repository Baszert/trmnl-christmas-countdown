<div class="layout">
  <div class="xmas xmas--quadrant" data-card="tl" {{ xmas_attrs }}>
    <pre class="xmas__art"></pre>
    <div class="xmas__card bg--white">
      <span class="label lg:label--base xmas__pre"></span>
      <span class="value value--large lg:value--xlarge value--tnums xmas__num">{{ xmas_days }}</span>
      <span class="title title--base lg:title--large xmas__big hidden"></span>
      <span class="description lg:description--large xmas__label">days until Christmas</span>
      <span class="label label--small lg:label--base xmas__sub hidden"></span>
    </div>
    <span class="label label--small lg:label--base xmas__datebox bg--white"><span class="xmas__date"></span></span>
  </div>
</div>
