<div class="layout">
  <div class="xmas xmas--half_vertical" data-card="top" {{ xmas_attrs }}>
    <pre class="xmas__art"></pre>
    <div class="xmas__card bg--white">
      <span class="label lg:label--large xmas__pre"></span>
      <span class="value value--xlarge lg:value--xxxlarge value--tnums xmas__num">{{ xmas_days }}</span>
      <span class="title title--large lg:title--xxlarge xmas__big hidden"></span>
      <span class="description lg:description--xlarge xmas__label">days until Christmas</span>
      <span class="label label--small lg:label--base xmas__sub hidden"></span>
    </div>
    <span class="label label--small lg:label--base xmas__datebox bg--white"><span class="xmas__date"></span></span>
  </div>
</div>
